<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Plain HTTP only on the local network
	     (prototype server); public servers must use HTTPS. -->
	<!-- Default scrutiny server (sdd/specs/server-location/SPEC.md). -->
	<key>CCDefaultServerURL</key>
	<string>$(CC_DEFAULT_SERVER_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
