{
  "flow": "capture",
  "template": "demo-2027",
  "comparison": "Run `events` (after the optional `prelude`) from the initial state. `expectState` is the leaf path afterwards; `expectEffects` and `expectIgnored` describe the last event only; `expectContext` is matched as a partial deep structure (every listed key must match, arrays exactly). All data is fictitious.",
  "preludes": {
    "toEditing": ["acceptBup"],
    "toValuesComplete": [
      "acceptBup",
      { "type": "chooseDocumentType", "payload": { "documentType": "certificado" } },
      { "type": "setMesa", "payload": { "mesa": { "distrito": "99", "seccion": "001", "circuito": "0001A", "mesa": "00042" } } },
      { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }] } },
      { "type": "setValues", "payload": {
        "header": { "electores": 350, "votantes": 300 },
        "cells": {
          "presidente": { "lista-a": 120, "lista-b": 100, "lista-c": 60, "blanco": 10, "nulos": 7, "recurridos": 2, "impugnados": 1 },
          "diputados": { "lista-a": 110, "lista-b": 95, "lista-c": 70, "blanco": 15, "nulos": 8, "recurridos": 1, "impugnados": 1 }
        } } }
    ],
    "toValidationClean": [{ "prelude": "toValuesComplete" }, "review"],
    "toValidationWarning": [
      { "prelude": "toValuesComplete" },
      { "type": "setValues", "payload": { "cells": { "presidente": { "lista-a": 121 } } } },
      "review"
    ],
    "toValidationError": [
      { "prelude": "toValuesComplete" },
      { "type": "setValues", "payload": { "cells": { "diputados": { "lista-c": null } } } },
      "review"
    ],
    "toCompareMatch": [
      { "prelude": "toValidationClean" },
      "requestDoubleEntry",
      "secondReady",
      { "type": "setSecondValues", "payload": { "votantes": 300, "totals": { "presidente": 300, "diputados": 300 } } },
      "submitSecond"
    ],
    "toCompareMismatch": [
      { "prelude": "toValidationClean" },
      "requestDoubleEntry",
      "secondReady",
      { "type": "setSecondValues", "payload": { "votantes": 300, "totals": { "presidente": 310, "diputados": 300 } } },
      "submitSecond"
    ]
  },
  "cases": [
    {
      "name": "initial state is the BUP warning",
      "events": [],
      "expectState": "bupWarning",
      "expectEffects": [],
      "expectContext": { "presentation": "f2", "locked": false, "doubleEntry": "none" }
    },
    {
      "name": "acceptBup enters editing through its initial child",
      "events": ["acceptBup"],
      "expectState": "editing.documentType",
      "expectEffects": []
    },
    {
      "name": "F-1 wizard: full happy path to confirmed",
      "events": [
        "acceptBup",
        { "type": "chooseDocumentType", "payload": { "documentType": "telegrama" } },
        "next",
        { "type": "setMesa", "payload": { "mesa": { "distrito": "99", "seccion": "001", "circuito": "0001A", "mesa": "00042" } } },
        "next",
        { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }] } },
        "next",
        { "type": "setValues", "payload": {
          "header": { "electores": { "value": 350, "origin": "ocr-accepted" }, "votantes": 300 },
          "cells": {
            "presidente": { "lista-a": 120, "lista-b": 100, "lista-c": 60, "blanco": 10, "nulos": 7, "recurridos": 2, "impugnados": 1 },
            "diputados": { "lista-a": 110, "lista-b": 95, "lista-c": 70, "blanco": 15, "nulos": 8, "recurridos": 1, "impugnados": 1 }
          } } },
        "next",
        "proceed",
        "confirm"
      ],
      "expectState": "confirmed",
      "expectEffects": ["hashEvidence", "persist"],
      "expectContext": {
        "documentType": "telegrama",
        "locked": true,
        "header": { "electores": { "value": 350, "origin": "ocr-accepted" }, "votantes": { "value": 300, "origin": "manual" } }
      }
    },
    {
      "name": "F-1: requestScan is an internal transition with the scan effect",
      "prelude": "toEditing",
      "events": [
        { "type": "chooseDocumentType", "payload": { "documentType": "acta" } },
        "next",
        { "type": "setMesa", "payload": { "mesa": { "distrito": "99", "seccion": "001", "circuito": "0001A", "mesa": "00042" } } },
        "next",
        "requestScan"
      ],
      "expectState": "editing.pages",
      "expectEffects": ["scan"]
    },
    {
      "name": "pagesAdded persists and asks for OCR",
      "prelude": "toEditing",
      "events": [{ "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "photos" }, { "id": "p2", "source": "photos" }] } }],
      "expectState": "editing.documentType",
      "expectEffects": ["persist", "ocr"],
      "expectContext": { "pages": [{ "id": "p1", "source": "photos" }, { "id": "p2", "source": "photos" }] }
    },
    {
      "name": "pagesAdded ignores duplicate page ids",
      "prelude": "toEditing",
      "events": [
        { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }] } },
        { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }, { "id": "p2", "source": "scanner" }] } }
      ],
      "expectState": "editing.documentType",
      "expectEffects": ["persist", "ocr"],
      "expectContext": { "pages": [{ "id": "p1", "source": "scanner" }, { "id": "p2", "source": "scanner" }] }
    },
    {
      "name": "removePage drops the page",
      "prelude": "toEditing",
      "events": [
        { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }, { "id": "p2", "source": "scanner" }] } },
        { "type": "removePage", "payload": { "id": "p1" } }
      ],
      "expectState": "editing.documentType",
      "expectEffects": ["persist"],
      "expectContext": { "pages": [{ "id": "p2", "source": "scanner" }] }
    },
    {
      "name": "useSample fills the mesa, adds sample pages and marks the capture",
      "prelude": "toEditing",
      "events": [{ "type": "useSample", "payload": { "sample": { "id": "ejemplo-01", "label": "Ejemplo 1", "mesa": { "distrito": "99", "seccion": "002", "circuito": "0002B", "establecimiento": "Escuela ficticia 1", "mesa": "00101" }, "pages": [{ "id": "s1-p1" }] } } }],
      "expectState": "editing.documentType",
      "expectEffects": ["persist", "ocr"],
      "expectContext": {
        "mesa": { "distrito": "99", "seccion": "002", "circuito": "0002B", "establecimiento": "Escuela ficticia 1", "mesa": "00101" },
        "pages": [{ "id": "s1-p1", "source": "sample" }],
        "sample": { "id": "ejemplo-01", "label": "Ejemplo 1" }
      }
    },
    {
      "name": "F-2: data in any order, then review from the editing region",
      "prelude": "toEditing",
      "events": [
        { "type": "setValues", "payload": { "header": { "votantes": 300, "electores": 350 } } },
        { "type": "pagesAdded", "payload": { "pages": [{ "id": "p1", "source": "scanner" }] } },
        { "type": "setMesa", "payload": { "mesa": { "mesa": "00042", "distrito": "99", "seccion": "001", "circuito": "0001A" } } },
        { "type": "chooseDocumentType", "payload": { "documentType": "certificado" } },
        { "type": "setValues", "payload": { "cells": {
          "presidente": { "lista-a": 120, "lista-b": 100, "lista-c": 60, "blanco": 10, "nulos": 7, "recurridos": 2, "impugnados": 1 },
          "diputados": { "lista-a": 110, "lista-b": 95, "lista-c": 70, "blanco": 15, "nulos": 8, "recurridos": 1, "impugnados": 1 } } } },
        "review",
        "proceed"
      ],
      "expectState": "confirming",
      "expectEffects": []
    },
    {
      "name": "setValues with null clears a value",
      "prelude": "toValuesComplete",
      "events": [{ "type": "setValues", "payload": { "header": { "electores": null } } }],
      "expectState": "editing.documentType",
      "expectEffects": ["persist"],
      "expectContext": { "header": { "votantes": { "value": 300, "origin": "manual" } } }
    },
    {
      "name": "warning without justification: confirm ignored, then justified confirm succeeds",
      "prelude": "toValidationWarning",
      "events": [
        "proceed",
        "confirm",
        { "type": "setJustification", "payload": { "justification": "El acta dice 301 votantes." } },
        "confirm"
      ],
      "expectState": "confirmed",
      "expectEffects": ["hashEvidence", "persist"],
      "expectContext": { "locked": true, "justification": "El acta dice 301 votantes." }
    },
    {
      "name": "confirming: back returns to validation",
      "prelude": "toValidationClean",
      "events": ["proceed", "back"],
      "expectState": "validation",
      "expectEffects": []
    },
    {
      "name": "validation: edit goes back to the values editor",
      "prelude": "toValidationError",
      "events": [{ "type": "edit", "payload": { "path": "cells.diputados.lista-c" } }],
      "expectState": "editing.values",
      "expectEffects": []
