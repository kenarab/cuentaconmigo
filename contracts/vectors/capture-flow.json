      "expectEffects": ["persist"],
      "expectContext": { "doubleEntry": "matched", "mismatches": [] }
    },
    {
      "name": "F-3: fix the first entry, compare again, accept",
      "presentation": "f3",
      "prelude": "toCompareMismatch",
      "events": [
        "fixFirstEntry",
        { "type": "setValues", "payload": { "header": { "votantes": 310 }, "cells": { "presidente": { "lista-a": 130 }, "diputados": { "lista-a": 120 } } } },
        "next",
        "compareAgain"
      ],
      "expectState": "compare",
      "expectEffects": [],
      "expectContext": { "doubleEntry": "pending", "mismatches": [{ "path": "header.votantes", "first": 310, "second": 300 }, { "path": "cells.diputados", "first": 310, "second": 300 }] }
    },
    {
      "name": "F-3: while pending, proceed is ignored until the comparison is cancelled",
      "presentation": "f3",
      "prelude": "toCompareMismatch",
      "events": ["fixFirstEntry", "next", "proceed", "cancelDoubleEntry", "proceed"],
      "expectState": "confirming",
      "expectEffects": [],
      "expectContext": { "doubleEntry": "none", "second": null }
    },
    {
